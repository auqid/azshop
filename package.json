{
  "name": "azshop",
  "version": "2.0.0",
  "description": "Nargis — a Kashmiri crafts store built with the MERN stack",
  "type": "module",
  "main": "backend/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder.js",
    "data:destroy": "node backend/seeder.js -d",
    "build": "npm install && npm install --include=dev --prefix frontend && npm run build --prefix frontend"
  },
  "author": "auqid",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^3.1.14"
  }
}
